---
/**
 * Presenter console (spec §7.4).
 *
 * Opened with `S` from the deck. Shows the current slide, the next slide, the
 * notes for the current slide, an elapsed timer, and the lesson's timing plan.
 * Stays in step with the deck window over BroadcastChannel('deck').
 *
 * The two slide previews are the *real* deck page in an iframe at ?thumb=1,
 * rather than a re-render of the slides. That means the parent is looking at
 * exactly what is on the kids' screens — including any applet mid-state — and
 * that this page cannot drift from the deck as layouts change.
 *
 * Note this is a route, not `?presenter=1`. On a static host a query string
 * cannot change the HTML that shipped, and spec §6 requires the notes to be
 * genuinely absent from the deck rather than hidden. See src/lib/mode.ts.
 */
import { render } from 'astro:content'
import BaseHead from '@layouts/BaseHead.astro'
import { lessonPaths, type Lesson, type Unit } from '@lib/content'
import { lessonHref, guideHref } from '@lib/href'
import '@styles/prose.css'
import '@styles/guide.css'
import '@styles/presenter.css'

export async function getStaticPaths() {
  return lessonPaths()
}

interface Props {
  lesson: Lesson
  unit?: Unit
}

const { lesson } = Astro.props
const { Content } = await render(lesson)
const d = lesson.data
const deckUrl = lessonHref(d.n)
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Presenter · ${d.title}`} />
  </head>
  <body class="body--presenter">
    <div class="presenter" data-presenter data-lesson={d.n} data-deck-url={deckUrl} data-unit={d.unit}>
      <header class="presenter__bar">
        <p class="presenter__title">
          <span class="presenter__n">{String(d.n).padStart(2, '0')}</span>
          {d.title}
        </p>
        <p class="presenter__pos">
          <span data-pos>1</span> / <span data-count>?</span>
        </p>
        <p class="presenter__clock">
          <button type="button" data-timer-toggle aria-label="Start or pause the timer">Start</button>
          <output data-timer aria-live="off">00:00</output>
          <span class="presenter__budget">of {d.duration}:00</span>
          <button type="button" data-timer-reset>Reset</button>
        </p>
      </header>

      <main class="presenter__grid">
        <section class="presenter__now" aria-label="Current slide">
          <iframe
            class="presenter__frame"
            data-frame="now"
            src={`${deckUrl}?thumb=1#1`}
            title="The slide the children are looking at"></iframe>
        </section>

        <section class="presenter__notes" aria-label="Notes for the current slide">
          <div class="presenter__notes-inner" data-notes-host></div>
        </section>

        <section class="presenter__next" aria-label="Next slide">
          <p class="presenter__label">Next</p>
          <iframe
            class="presenter__frame"
            data-frame="next"
            src={`${deckUrl}?thumb=1#2`}
            title="The slide that comes next"></iframe>
        </section>

        <section class="presenter__plan" aria-label="Timing plan">
          <p class="presenter__label">Plan</p>
          {
            d.timing.length ? (
              <ol class="presenter__timing">
                {d.timing.map((t) => (
                  <li data-slides={t.slides}>
                    <span class="presenter__time">
                      {t.from}&ndash;{t.to}
                    </span>
                    <span>{t.part}</span>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="presenter__none">
                No timing plan in this lesson's frontmatter. Add a <code>timing:</code> list to
                see it here.
              </p>
            )
          }
          <p class="presenter__links">
            <a href={guideHref(d.n)} target="_blank" rel="noopener">Full guide</a>
          </p>
        </section>
      </main>
    </div>

    {/* The notes for every slide, rendered once and hidden here; the console
        moves the right one into view. This page is the parent's, so the notes
        being in its DOM is the entire point. */}
    <template data-notes-source>
      <Content />
    </template>

    <script>
      import '@components/deck/presenter.js'
    </script>
  </body>
</html>
