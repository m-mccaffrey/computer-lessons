---
import { render } from 'astro:content'
import GuideLayout from '@layouts/GuideLayout.astro'
import { lessonPaths, lessonIndex, type Lesson, type Unit } from '@lib/content'

export async function getStaticPaths() {
  return lessonPaths()
}

interface Props {
  lesson: Lesson
  unit?: Unit
}

const { lesson, unit } = Astro.props
const { Content } = await render(lesson)
const byN = await lessonIndex()

// callsBackTo / setsUp are not decoration — resolve them to real titles so the
// spiral is legible rather than a list of numbers.
const resolve = (ns: number[]) =>
  ns
    .map((n) => byN.get(n))
    .filter((l): l is Lesson => Boolean(l))
    .map((l) => ({ n: l.data.n, title: l.data.title }))

const threads = {
  back: resolve(lesson.data.callsBackTo),
  forward: resolve(lesson.data.setsUp),
}
---

<GuideLayout lesson={lesson} unitTitle={unit?.data.title ?? `Unit ${lesson.data.unit}`} threads={threads}>
  <Content />
</GuideLayout>
