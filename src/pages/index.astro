---
/**
 * Written for a stranger who found the repo, not for the family (spec §10).
 */
import PageLayout from '@layouts/PageLayout.astro'
import UnitSpine from '@components/UnitSpine.astro'
import { allUnits, lessonsByUnit, allLessons } from '@lib/content'
import { href, lessonHref, guideHref } from '@lib/href'

const units = await allUnits()
const byUnit = await lessonsByUnit()
const lessons = await allLessons()
const ready = lessons.filter((l) => l.data.status === 'ready' || l.data.status === 'taught')
const start = ready.at(0) ?? lessons.at(0)
---

<PageLayout
  title="Computers · A course for two kids"
  description="A 56-lesson course teaching two children to be competent, unafraid, non-mystified computer users."
>
  <div class="hero">
    <p class="eyebrow-text">A course for two kids</p>
    <h1>Computers</h1>
    <p class="thesis">
      A competent adult should be able to buy a computer, drive it, make documents with it,
      understand why it is slow, not lose their files, not get scammed, and not be afraid of it.
    </p>
    <p class="hero__sub">
      Fifty-six lessons for a seven-year-old and a nine-year-old, taught at a kitchen table with
      two Raspberry Pi 400s. Not a computer science course. Not an engineering course.
    </p>
    {
      start && (
        <p class="hero__cta">
          <a class="btn" href={lessonHref(start.data.n)}>
            Start at lesson {String(start.data.n).padStart(2, '0')} — {start.data.title}
          </a>
          <a class="btn btn--quiet" href={guideHref(start.data.n)}>
            Read the teacher guide
          </a>
        </p>
      )
    }
  </div>

  <section aria-labelledby="h-units">
    <h2 id="h-units" class="section-h">The nine units</h2>
    <UnitSpine units={units} counts={byUnit} />
  </section>

  <section class="cols" aria-labelledby="h-what">
    <div>
      <h2 id="h-what" class="section-h">What this is</h2>
      <div class="prose">
        <p>
          A course built for two specific children, published because it might be useful to
          someone else with the same problem. The through-line is competence rather than
          coverage: at the end they should be able to walk up to an unfamiliar machine and not
          be afraid of it.
        </p>
        <p>
          It is a website rather than a stack of slide decks for one reason above the others — a
          binary counter you can click beats a picture of one, and a pixel grid that computes
          its own file size teaches Unit 3 in a way slides cannot.
        </p>
      </div>
    </div>

    <div>
      <h2 class="section-h">How it is put together</h2>
      <div class="prose">
        <p>
          Every lesson is one file. The kids get a <a href={href('lessons/01')}>deck</a> — big
          type, one idea a slide, nearly wordless. The parent gets a{' '}
          <a href={href('lessons/01/guide')}>guide</a> from that same file: what to gather, what
          to say, what goes wrong, and the answers.
        </p>
        <p>
          The <a href={href('materials')}>materials list</a> and the{' '}
          <a href={href('glossary')}>glossary</a> are generated from the lessons, so they cannot
          quietly stop being true.
        </p>
      </div>
    </div>
  </section>

  <section class="cols" aria-labelledby="h-not">
    <div>
      <h2 id="h-not" class="section-h">What it never does</h2>
      <ul class="nots">
        <li>No accounts, no backend, no database.</li>
        <li>No analytics. Nothing about the children is tracked, counted, or sent anywhere.</li>
        <li>No scores, no streaks, no badges, no gamification.</li>
        <li>Works offline once loaded, because home internet failing must not cancel a lesson.</li>
      </ul>
    </div>
    <div>
      <h2 class="section-h">Where to start</h2>
      <div class="prose">
        <p>
          Read <a href={href('curriculum')}>the curriculum</a> for the whole arc, then open{' '}
          <a href={href('lessons/01')}>lesson 1</a>. It is unplugged: a table of household
          objects under a towel, and no computer switched on at all.
        </p>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .hero {
    max-width: 40ch;
    margin-bottom: var(--space-9);
  }

  .hero h1 {
    font-size: clamp(3rem, 2rem + 7vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-5);
  }

  .thesis {
    font-family: var(--font-prose);
    font-size: clamp(1.125rem, 1rem + 0.9vw, 1.5rem);
    line-height: 1.45;
    margin: 0 0 var(--space-5);
    padding-left: var(--space-5);
    border-left: 4px solid var(--accent);
    text-wrap: pretty;
  }

  .hero__sub {
    font-family: var(--font-prose);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0 0 var(--space-6);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
  }

  .btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: 12px 18px;
    background: var(--ink);
    color: var(--paper);
    border: var(--hairline) solid var(--ink);
    border-radius: var(--radius-card);
    text-decoration: none;
  }

  .btn:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  .btn--quiet {
    background: transparent;
    color: var(--ink-2);
    border-color: var(--grid);
  }

  .btn--quiet:hover {
    background: transparent;
    color: var(--accent);
    border-color: var(--accent);
  }

  .section-h {
    font-size: 1.125rem;
    padding-bottom: var(--space-3);
    border-bottom: var(--hairline) solid var(--grid);
    margin-bottom: var(--space-5);
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-7);
    margin-top: var(--space-9);
  }

  .nots {
    font-family: var(--font-prose);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
    padding-left: var(--space-5);
    color: var(--ink-2);
    max-width: var(--page-measure);
  }

  .nots li + li {
    margin-top: var(--space-3);
  }
</style>
