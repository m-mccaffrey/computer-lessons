---
/**
 * The nine units as a ribbon-cable spine, laid horizontally.
 *
 * The same idea as the rail on every slide (spec §8.5), turned on its side and
 * given room to breathe: nine bands in the resistor colour code, each sized by
 * how many lessons it holds. It is the site's one recurring picture, so it
 * appears on the homepage and above the curriculum, and nowhere else.
 */
import { unitHref } from '@lib/href'
import type { Unit, Lesson } from '@lib/content'

interface Props {
  units: Unit[]
  /** Lessons per unit, used to weight each band. */
  counts: Map<number, Lesson[]>
}

const { units, counts } = Astro.props
---

<nav class="spine" aria-label="The nine units">
  <ol class="spine__bands">
    {
      units.map((u) => {
        const lessons = counts.get(u.data.n) ?? []
        return (
          <li class="spine__band" data-unit={u.data.n} style={`--weight:${lessons.length || 1}`}>
            <a href={unitHref(u.data.n)}>
              <span class="spine__swatch" aria-hidden="true" />
              <span class="spine__n">{u.data.n}</span>
              <span class="spine__title">{u.data.title}</span>
              <span class="spine__count">
                {lessons.length} {lessons.length === 1 ? 'lesson' : 'lessons'}
              </span>
            </a>
          </li>
        )
      })
    }
  </ol>
</nav>

<style>
  .spine {
    margin: 0 0 var(--space-8);
  }

  .spine__bands {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2px;
  }

  .spine__band {
    flex: var(--weight, 1) 1 150px;
  }

  .spine__band a {
    display: block;
    padding: var(--space-3) var(--space-3) var(--space-4);
    background: var(--paper-2);
    text-decoration: none;
    color: var(--ink);
    border-radius: var(--radius-card);
  }

  .spine__band a:hover {
    background: var(--paper);
    outline: var(--hairline) solid var(--grid);
  }

  /* The band itself. 6px of resistor colour is the whole idea. */
  .spine__swatch {
    display: block;
    height: 6px;
    background: var(--accent);
    margin-bottom: var(--space-3);
  }

  .spine__n {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-3);
  }

  .spine__title {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.15;
    margin: 2px 0 var(--space-2);
    text-wrap: balance;
  }

  .spine__count {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-3);
  }
</style>
