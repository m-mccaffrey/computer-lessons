---
/**
 * The spiral moment: "remember the four boxes?"
 *
 * Spec §9 is emphatic that the callback must show *the actual earlier slide*,
 * ghosted, not a redrawing of it — because a redrawing drifts, and the whole
 * point is that they recognise the thing they drew in their notebook.
 *
 * So this renders the real deck page in an iframe, parked at the referenced
 * slide, scaled down and ghosted back. `?thumb=1` tells deck.js on the far side
 * to drop its chrome and its keyboard handlers, so it is inert scenery. It is
 * lazy-loaded, aria-hidden, and pointer-events:none; the accessible version of
 * the callback is the visible link in the caption.
 */
import { lessonHref, lessonSlug, href } from '@lib/href'

interface Props {
  /** The lesson being called back to. */
  lesson: number
  /** Slide number within that lesson, 1-based — the number printed on it. */
  slide?: number
  /** What that slide was, for the caption and the alt-path. */
  label?: string
}

const { lesson, slide = 1, label } = Astro.props
const src = `${href(`lessons/${lessonSlug(lesson)}`)}?thumb=1#${slide}`
const caption = label ?? `Lesson ${lesson}`
---

<div class="l-callback">
  <div class="l-callback__ghost" aria-hidden="true">
    <iframe
      class="l-callback__frame"
      src={src}
      loading="lazy"
      tabindex="-1"
      title=""
      scrolling="no"></iframe>
  </div>
  <div class="l-callback__claim">
    <slot />
    <p class="l-callback__cite">
      <a href={lessonHref(lesson, slide)}>← {caption}</a>
    </p>
  </div>
</div>
