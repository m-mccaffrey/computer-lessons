---
/**
 * "Now do this." Graph-paper ground, because the ground changing is the signal
 * that they are about to be out of their chairs (spec §8.6).
 */
interface Props {
  /** Materials chip row, e.g. ["sticky notes", "marker"]. */
  materials?: string[]
  /** Optional minutes. Shown as a static chip, not a running countdown —
      nothing on this site puts a child under time pressure. */
  minutes?: number
}
const { materials = [], minutes } = Astro.props
---
<div class="l-activity">
  <div class="l-activity__body"><slot /></div>
  {(materials.length > 0 || minutes) && (
    <ul class="chips">
      {materials.map((m) => <li class="chip">{m}</li>)}
      {minutes && <li class="chip chip--time">{minutes} min</li>}
    </ul>
  )}
</div>
