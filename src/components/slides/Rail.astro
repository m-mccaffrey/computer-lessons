---
/**
 * The unit spine (spec §8.5) — the one risk the design takes.
 *
 * A 28px column down the left edge of every slide: nine stripes, one per unit,
 * in the resistor colour code, with the current unit lit; then a hairline in
 * --accent whose fill encodes progress through this lesson.
 *
 * So from across the room: which unit we are in (colour), how far into the
 * course (which stripe is lit), how far into today (fill height). It is the
 * table of contents, the progress bar, and the unit identity in one column.
 *
 * There is no second progress indicator anywhere on the site. This is it.
 *
 * Takes no props. Which stripe is lit comes from data-unit on the deck root,
 * and the fill comes from --rail-progress, which Deck.astro stamps per slide.
 */
const UNITS = [0, 1, 2, 3, 4, 5, 6, 7, 8]
---

<div class="rail" aria-hidden="true">
  <div class="rail__stripes">
    {UNITS.map((u) => <span class="rail__stripe" data-stripe-unit={u} />)}
  </div>
  <div class="rail__track">
    <div class="rail__fill"></div>
  </div>
</div>
