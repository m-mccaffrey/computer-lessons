---
/** Edge-to-edge photograph with the headline on a scrim at bottom left. */
interface Props {
  image?: string
  /** Written as what the picture *teaches*, not "photo of ENIAC". */
  alt?: string
}
const { image, alt } = Astro.props
---
<div class="l-full-bleed">
  {image && <img class="l-full-bleed__img" src={image} alt={alt ?? ''} />}
  <div class="l-full-bleed__scrim"><slot /></div>
</div>
