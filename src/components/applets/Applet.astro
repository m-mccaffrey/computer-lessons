---
/**
 * Wraps an applet so it degrades (spec §11.10) and so the deck knows to hand it
 * the arrow keys (spec §7.5).
 *
 * The custom element tag is written out by name rather than imported: applets
 * are plain custom elements precisely so that they keep working when this site
 * is no longer an Astro site.
 */
import { appletByTag } from '@lib/applets'

interface Props {
  tag: string
  /** Attributes forwarded to the custom element, e.g. width="16". */
  attrs?: Record<string, string | number>
}

const { tag, attrs = {} } = Astro.props
const meta = appletByTag.get(tag)
const Tag = tag as unknown as keyof HTMLElementTagNameMap
---

<div class="applet" data-applet data-tag={tag}>
  {
    meta?.built === false ? (
      <p class="applet__missing">
        <code>&lt;{tag}&gt;</code> is not built yet.
        {meta.misconception && <span> It will fix: {meta.misconception}</span>}
      </p>
    ) : (
      <Tag {...attrs} />
    )
  }

  <noscript>
    <p class="applet__missing">
      <code>&lt;{tag}&gt;</code> needs JavaScript.
      {meta?.misconception ?? 'It is an interactive demonstration.'}
    </p>
  </noscript>
</div>

<style>
  .applet {
    display: block;
    height: 100%;
    min-height: 0;
  }

  .applet__missing {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-3);
    border: 1px dashed var(--grid);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    margin: 0;
  }

  .applet__missing code {
    color: var(--accent);
  }
</style>
