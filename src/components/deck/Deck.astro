---
/**
 * The deck shell: the scaled canvas viewport, the chrome, and the engine.
 *
 * Everything that is constant for a whole deck lives here as a data attribute or
 * a custom property, so that individual slides stay ignorant of their lesson.
 * Everything that varies per slide is stamped onto the rendered HTML by
 * stampSlides(), which is the only place that can count them.
 */
import { stampSlides, cssString } from '@lib/stamp'
import { presenterHref, guideHref, lessonHref } from '@lib/href'

interface Props {
  n: number
  unit: number
  unitTitle: string
  title: string
  /** Presenter view renders the same slides beside the notes; it does not nest a Deck. */
  variant?: 'deck' | 'presenter-preview'
}

const { n, unit, unitTitle, title, variant = 'deck' } = Astro.props

const rendered = await Astro.slots.render('default')
const { html, total } = stampSlides(rendered)

const eyebrow = `Unit ${unit} · ${unitTitle}`
const style = [
  `--eyebrow:${cssString(eyebrow)}`,
  `--slide-total:${total}`,
  `counter-reset: slide-total ${total}`,
].join(';')
---

<div
  class="deck"
  data-deck
  data-unit={unit}
  data-lesson={n}
  data-total={total}
  data-variant={variant}
  style={style}
>
  <div class="deck__stage" data-stage>
    <div class="deck__slides" data-slides set:html={html} />
  </div>

  {/* ---- chrome. All of it is hidden in ?thumb=1 and in print. ---- */}
  <div class="deck__chrome" data-chrome>
    <nav class="deck__bar" aria-label="Deck controls">
      <button type="button" data-act="prev" aria-label="Previous slide">&#8592;</button>
      <button type="button" data-act="next" aria-label="Next slide">&#8594;</button>
      <button type="button" data-act="overview" aria-label="Slide overview" aria-pressed="false">Overview</button>
      <button type="button" data-act="mode" aria-label="Toggle present and read mode">Read</button>
      <button type="button" data-act="presenter" aria-label="Open presenter window">Presenter</button>
      <button type="button" data-act="fullscreen" aria-label="Fullscreen">Full</button>
      <button type="button" data-act="help" aria-label="Keyboard help">?</button>
      <a class="deck__bar-link" href={guideHref(n)}>Guide</a>
      <span class="deck__offline" data-offline hidden>Available offline</span>
    </nav>
  </div>

  {/* Click/tap zones: right third next, left third previous, middle nothing so
      applets stay clickable (spec §7.3). */}
  <div class="deck__zones" data-zones aria-hidden="true">
    <div class="deck__zone" data-zone="prev"></div>
    <div class="deck__zone" data-zone="none"></div>
    <div class="deck__zone" data-zone="next"></div>
  </div>

  {/* Blackout. You will use this constantly with a seven-year-old. */}
  <div class="deck__blackout" data-blackout hidden></div>

  <div class="deck__applet-hint" data-applet-hint hidden>
    <kbd>esc</kbd> to leave
  </div>

  <dialog class="deck__help" data-help>
    <h2>Keys</h2>
    <dl>
      <div><dt><kbd>&#8594;</kbd> <kbd>&#8595;</kbd> <kbd>space</kbd></dt><dd>Next beat, then next slide</dd></div>
      <div><dt><kbd>&#8592;</kbd> <kbd>&#8593;</kbd></dt><dd>Back</dd></div>
      <div><dt><kbd>home</kbd> / <kbd>end</kbd></dt><dd>First / last slide</dd></div>
      <div><dt><kbd>f</kbd></dt><dd>Fullscreen</dd></div>
      <div><dt><kbd>o</kbd></dt><dd>Overview grid</dd></div>
      <div><dt><kbd>p</kbd></dt><dd>Present / read</dd></div>
      <div><dt><kbd>s</kbd></dt><dd>Presenter window</dd></div>
      <div><dt><kbd>b</kbd></dt><dd>Blackout — everyone look at me</dd></div>
      <div><dt><kbd>tab</kbd></dt><dd>Into an applet. <kbd>esc</kbd> to leave</dd></div>
      <div><dt><kbd>?</kbd></dt><dd>This</dd></div>
    </dl>
    <button type="button" data-act="close-help">Close</button>
  </dialog>

  {/* Slide changes are announced politely; the kids' screen readers should not
      interrupt the teacher mid-sentence. */}
  <p class="sr-only" aria-live="polite" data-announce></p>
</div>

<a class="sr-only" href={lessonHref(n)} data-deck-self>{title}</a>
