---
/**
 * An incremental reveal inside a slide. Advancing the deck reveals the next
 * <Beat> before moving on to the next slide.
 *
 * In the guide every beat is simply visible — the parent is reading, not
 * presenting, and hiding them would only make the guide harder to scan.
 */
import { renderMode } from '@lib/mode'

interface Props {
  /** Render as a block rather than inline. Default: block. */
  inline?: boolean
}

const { inline = false } = Astro.props
const mode = renderMode(Astro.url.pathname)
const isDeck = mode === 'deck' || mode === 'presenter'
const Tag = inline ? 'span' : 'div'
---

<Tag class="beat" data-beat={isDeck ? '' : undefined} data-static={isDeck ? undefined : ''}>
  <slot />
</Tag>

<style>
  .beat {
    /* Revealed state is the default so that a deck with no JS reads correctly.
       The engine adds .deck--js to the root, which is what arms the hiding. */
    opacity: 1;
  }

  :global(.deck--js) .beat[data-beat] {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--t-beat) var(--ease),
      transform var(--t-beat) var(--ease);
  }

  :global(.deck--js) .beat[data-beat][data-shown] {
    opacity: 1;
    transform: none;
  }

  /* Beats never collapse layout — a slide must not reflow as it reveals, or the
     kids track the movement instead of the idea. */
</style>
