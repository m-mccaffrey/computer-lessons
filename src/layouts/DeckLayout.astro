---
import BaseHead from './BaseHead.astro'
import Deck from '@components/deck/Deck.astro'
import '@styles/deck.css'

interface Props {
  n: number
  unit: number
  unitTitle: string
  title: string
  goal?: string
}

const { n, unit, unitTitle, title, goal } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${title} · Lesson ${n}`} description={goal} />
  </head>
  <body class="body--deck">
    <a class="skip-link" href="#deck">Skip to the slides</a>
    <h1 class="sr-only">Lesson {n}: {title}</h1>
    <main id="deck">
      <Deck n={n} unit={unit} unitTitle={unitTitle} title={title}>
        <slot />
      </Deck>
    </main>
    <script>
      import '@components/deck/deck.js'
      // Only fetches the applets this lesson actually uses.
      import '@components/applets/loader.js'
    </script>
    <style is:global>
      .body--deck {
        overflow: hidden;
      }
      /* Read and overview modes scroll; present mode does not. */
      .body--deck:has(.deck[data-mode='read']),
      .body--deck:has(.deck[data-mode='overview']) {
        overflow: auto;
      }
      /* With JS off the deck is a scrolling stack, so scrolling must work. */
      .body--deck:has(.deck:not(.deck--js)) {
        overflow: auto;
      }
    </style>
  </body>
</html>
