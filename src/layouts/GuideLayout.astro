---
/**
 * The teacher guide. Everything the parent needs the night before, and nothing
 * that belongs on a slide.
 *
 * Same source file as the deck: <Notes> renders here and is absent there, and
 * each <Slide> renders as a readable block rather than a canvas. Print-friendly,
 * because this is a document you want beside you rather than on the screen you
 * are presenting from.
 */
import BaseHead from './BaseHead.astro'
import { href, lessonHref, presenterHref, guideHref } from '@lib/href'
import { stampSlides } from '@lib/stamp'
import type { Lesson } from '@lib/content'
import '@styles/prose.css'
import '@styles/guide.css'

interface Props {
  lesson: Lesson
  unitTitle: string
  /** Lessons this one depends on / feeds, resolved to titles. */
  threads: { back: Array<{ n: number; title: string }>; forward: Array<{ n: number; title: string }> }
}

const { lesson, unitTitle, threads } = Astro.props
const d = lesson.data

// Same stamping as the deck, so the walk-through numbers match the numbers
// printed on the slides the parent is looking at.
const { html: walkthrough } = stampSlides(await Astro.slots.render('default'), { headingLevel: 3 })
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${d.title} · Teacher guide`} description={d.goal} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page guide" data-unit={d.unit}>
      <header class="site-nav">
        <nav class="site-nav__inner" aria-label="Main">
          <a class="site-nav__home" href={href('')}>Computers</a>
          <ul>
            <li><a href={href('curriculum')}>Curriculum</a></li>
            <li><a href={lessonHref(d.n)}>Open the deck</a></li>
            <li><a href={presenterHref(d.n)} target="_blank" rel="noopener">Presenter view</a></li>
          </ul>
        </nav>
      </header>

      <main class="page__body" id="main">
        <div class="page-head">
          <p class="eyebrow-text">
            Lesson {d.n} · Unit {d.unit} · {unitTitle} · Teacher guide
          </p>
          <h1>{d.title}</h1>
          <p class="lede">{d.goal}</p>
          <p class="guide__chips">
            <span class="tag">{d.duration} min</span>
            <span class="tag" data-status={d.status}>{d.status}</span>
            {d.unplugged && <span class="tag tag--accent">Unplugged — Pis stay closed</span>}
          </p>
        </div>

        {/* ---- what to have ready ---- */}
        <section class="guide__section" aria-labelledby="h-prep">
          <h2 id="h-prep">Before they walk in</h2>
          <div class="guide__cols">
            <div>
              <h3>Props</h3>
              {
                d.props.length ? (
                  <ul class="guide__list">{d.props.map((p) => <li>{p}</li>)}</ul>
                ) : (
                  <p class="guide__none">Nothing to gather.</p>
                )
              }
            </div>
            <div>
              <h3>Prep</h3>
              {
                d.prep.length ? (
                  <ul class="guide__list">{d.prep.map((p) => <li>{p}</li>)}</ul>
                ) : (
                  <p class="guide__none">Nothing to do in advance.</p>
                )
              }
            </div>
          </div>
        </section>

        {/* ---- timing ---- */}
        {
          d.timing.length > 0 && (
            <section class="guide__section" aria-labelledby="h-timing">
              <h2 id="h-timing">Timing</h2>
              <div class="scroll-x">
                <table class="guide__table">
                  <thead>
                    <tr>
                      <th scope="col">Time</th>
                      <th scope="col">Part</th>
                      <th scope="col">Slides</th>
                    </tr>
                  </thead>
                  <tbody>
                    {d.timing.map((t) => (
                      <tr>
                        <td class="guide__time">
                          {t.from}&ndash;{t.to}
                        </td>
                        <td>{t.part}</td>
                        <td class="guide__time">{t.slides ?? ''}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )
        }

        {/* ---- the threads. The spiral only works if it is visible. ---- */}
        {
          (threads.back.length > 0 || threads.forward.length > 0) && (
            <section class="guide__section" aria-labelledby="h-threads">
              <h2 id="h-threads">Threads</h2>
              <div class="guide__cols">
                <div>
                  <h3>Builds on</h3>
                  {threads.back.length ? (
                    <ul class="guide__threads">
                      {threads.back.map((t) => (
                        <li>
                          <a href={lessonHref(t.n)}>
                            <span class="guide__threadn">{String(t.n).padStart(2, '0')}</span>
                            {t.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="guide__none">Nothing yet. This is a starting point.</p>
                  )}
                </div>
                <div>
                  <h3>Sets up</h3>
                  {threads.forward.length ? (
                    <ul class="guide__threads">
                      {threads.forward.map((t) => (
                        <li>
                          <a href={lessonHref(t.n)}>
                            <span class="guide__threadn">{String(t.n).padStart(2, '0')}</span>
                            {t.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="guide__none">Nothing depends on this one.</p>
                  )}
                </div>
              </div>
            </section>
          )
        }

        {/* ---- vocabulary ---- */}
        {
          d.vocab.length > 0 && (
            <section class="guide__section" aria-labelledby="h-vocab">
              <h2 id="h-vocab">New words</h2>
              <p class="guide__hint">Define each the first time it appears, and not before.</p>
              <ul class="guide__vocab">
                {d.vocab.map((v) => (
                  <li>
                    <a href={href(`glossary/#${encodeURIComponent(v)}`)}>{v}</a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {/* ---- the walk-through: every slide, with its notes ---- */}
        <section class="guide__section" aria-labelledby="h-walk">
          <h2 id="h-walk">Slide by slide</h2>
          <div set:html={walkthrough} />
        </section>

        {/* ---- pitfalls, extra problems, homework ---- */}
        {
          d.pitfalls.length > 0 && (
            <section class="guide__section" aria-labelledby="h-pitfalls">
              <h2 id="h-pitfalls">Where this goes wrong</h2>
              <ul class="guide__list guide__list--prose">
                {d.pitfalls.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          d.extraProblems.length > 0 && (
            <section class="guide__section" aria-labelledby="h-extra">
              <h2 id="h-extra">If there is time</h2>
              <ol class="guide__list guide__list--prose">
                {d.extraProblems.map((p) => (
                  <li>{p}</li>
                ))}
              </ol>
            </section>
          )
        }

        {
          d.homework && (
            <section class="guide__section" aria-labelledby="h-homework">
              <h2 id="h-homework">Homework</h2>
              <p class="prose">{d.homework}</p>
            </section>
          )
        }

        <p class="guide__footlinks">
          <a href={lessonHref(d.n)}>Open the deck</a> ·
          <a href={presenterHref(d.n)} target="_blank" rel="noopener">Presenter view</a> ·
          <a href={guideHref(d.n)}>Print this guide</a>
        </p>
      </main>
    </div>
  </body>
</html>
